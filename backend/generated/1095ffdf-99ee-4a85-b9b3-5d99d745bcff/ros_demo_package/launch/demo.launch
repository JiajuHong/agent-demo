<?xml version="1.0"?>
<launch>
    <!-- 
        Demo launch file for ROS publisher/subscriber demo
        This launches both publisher and subscriber nodes
    -->
    
    <node name="demo_publisher" 
          pkg="ros_demo_package" 
          type="publisher_node" 
          output="screen" />
    
    <node name="demo_subscriber" 
          pkg="ros_demo_package" 
          type="subscriber_node" 
          output="screen" />
    
</launch>